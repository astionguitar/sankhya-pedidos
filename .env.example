# Porta local da aplicação
PORT=3000

# Configurações do Sandbox da Sankhya
# URL Base do Gateway Sandbox
SANKHYA_API_URL=https://api.sandbox.sankhya.com.br

# Credenciais de Autenticação (Área do Desenvolvedor)
# Client ID e Client Secret são utilizados no cabeçalho Authorization: Basic
SANKHYA_CLIENT_ID=seu_client_id_aqui
SANKHYA_CLIENT_SECRET=seu_client_secret_aqui

# X-Token obtido na tela "Configurações Gateway" do Sankhya Om
SANKHYA_X_TOKEN=seu_x_token_aqui

# TOP apenas SUGERIDA na interface (opcional). O usuário escolhe a TOP;
# só TOPs ativas de Pedido de Venda (tipoMovimento=19) são listadas.
SANKHYA_TOP_SUGERIDA=3100

# Mapeamento EXPLÍCITO TOP -> Nota Modelo (JSON). Obrigatório para a TOP ficar pronta para pedido.
# Use apenas notas modelo realmente cadastradas no Sankhya Om para aquela TOP.
#   SANKHYA_NOTAS_MODELO={"<TOP>": <NOTA_MODELO>}
#   SANKHYA_NOTAS_MODELO={"<TOP>": {"notaModelo": <NOTA_MODELO>, "codigoEmpresa": <CODEMP>}}
SANKHYA_NOTAS_MODELO=
